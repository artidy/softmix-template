# MongoDB Configuration
MONGO_HOST=softmix.mongodb
MONGO_PORT=27017
MONGO_DB=softmix-uploader
MONGO_USER=admin
MONGO_PASSWORD=test
MONGO_AUTH_BASE=admin

# Application Configuration
PORT=7777

# File Upload Configuration
UPLOAD_DIRECTORY=/data/assets
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,image/webp

# JWT Configuration (for auth verification)
JWT_ACCESS_SECRET=your-secret-access-token-change-me
