MONGO_DB=diary-olgin-users
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_USER=admin
MONGO_PASSWORD=test
MONGO_AUTH_BASE=admin

MONGO_INITDB_ROOT_USERNAME="${MONGO_USER}"
MONGO_INITDB_ROOT_PASSWORD="${MONGO_PASSWORD}"
MONGO_INITDB_DATABASE="${MONGO_DB}"

ME_CONFIG_MONGODB_ADMINUSERNAME="${MONGO_USER}"
ME_CONFIG_MONGODB_ADMINPASSWORD="${MONGO_PASSWORD}"
ME_CONFIG_MONGODB_SERVER=diary-olgin_users_mongodb

JWT_SECRET=secret
EXP_SECRET_TIME=15m
JWT_REFRESH_SECRET=secretRefresh
EXP_REFRESH_SECRET_TIME=7d

# Ключ шифрования секретов в БД (настройки платёжных систем и т.п.).
# Сгенерировать: openssl rand -hex 32  (ровно 64 hex-символа = 32 байта)
# ВАЖНО: при смене ключа все ранее сохранённые секреты станут нечитаемы.
ENCRYPTION_KEY=

# Настройки SMTP, имя магазина, public URL, email админа — через админку
# /admin/mail-settings (значения хранятся в БД, секреты зашифрованы)
# Mailpit для dev доступен на softmix.mailpit:1025 (UI: http://localhost:8025)

# Платёжные системы (Freedom Pay, Kaspi, Halyk) настраиваются через админку
# /admin/payment-settings — значения хранятся зашифрованными в БД.

# WhatsApp Cloud API (Meta). Если ACCESS_TOKEN не задан — уведомления не шлются.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v18.0
WHATSAPP_LANGUAGE_CODE=ru
# Имена WhatsApp шаблонов (создаются и одобряются в Facebook Business Manager).
# Если пусто — отправляется свободным текстом (работает только в окне 24ч после ответа клиента).
WHATSAPP_TEMPLATE_ORDER_CREATED=
WHATSAPP_TEMPLATE_ORDER_STATUS_CHANGED=

# Telegram (для уведомлений админу о новом заказе)
# 1. Создайте бота через @BotFather и вставьте сюда токен
# 2. Найдите свой chat_id через @userinfobot и вставьте в TELEGRAM_ADMIN_CHAT_ID
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
