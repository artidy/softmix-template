# PostgreSQL Configuration
POSTGRES_HOST=softmix.postgres
POSTGRES_PORT=5432
POSTGRES_USER=admin
POSTGRES_PASSWORD=test
POSTGRES_DB=softmix-shop

# Application Configuration
PORT=4444

# JWT Configuration (for auth verification)
JWT_ACCESS_SECRET=your-secret-access-token-change-me

# Ключ шифрования токенов внешних сервисов (64 hex символа = 32 байта, сгенерировать: openssl rand -hex 32)
ENCRYPTION_KEY=your-64-char-hex-encryption-key-here
