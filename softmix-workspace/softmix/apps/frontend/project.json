{
  "name": "frontend",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/frontend/src",
  "projectType": "application",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": [
        "{workspaceRoot}/dist/apps/frontend"
      ],
      "defaultConfiguration": "production",
      "options": {
        "command": "vite build",
        "cwd": "apps/frontend"
      },
      "configurations": {
        "production": {},
        "development": {
          "command": "vite build --mode development"
        }
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "tsc -p apps/frontend/tsconfig.app.json --noEmit",
          "tsc -p apps/frontend/tsconfig.spec.json --noEmit"
        ],
        "parallel": false
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vite",
        "cwd": "apps/frontend"
      }
    },
    "preview": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vite preview",
        "cwd": "apps/frontend"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest run",
        "cwd": "apps/frontend"
      }
    },
    "e2e": {
      "executor": "nx:run-commands",
      "options": {
        "command": "playwright test",
        "cwd": "apps/frontend"
      },
      "cache": false
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": [
        "{options.outputFile}"
      ],
      "options": {
        "lintFilePatterns": [
          "apps/frontend/**/*.{ts,tsx,js,jsx}"
        ]
      }
    },
    "createImage": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "rimraf ./dist/apps/frontend && nx run frontend:build && docker build --file ./apps/frontend/Dockerfile --tag ghcr.io/artidy/softmix.frontend:latest . && docker push ghcr.io/artidy/softmix.frontend:latest"
        ]
      }
    }
  },
  "tags": []
}
